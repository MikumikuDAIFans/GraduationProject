# Core runtime
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
API_HOST_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8888,http://127.0.0.1:8888,http://localhost:8890,http://127.0.0.1:8890,http://localhost:4173,http://127.0.0.1:4173
CORS_ALLOW_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):\d+

# Database
SQLITE_DB_PATH=./data/app.db

# Queue / cache
REDIS_URL=redis://127.0.0.1:6379/0

# LLM
# Primary provider is SiliconFlow's OpenAI-compatible DeepSeek endpoint; Gemini is fallback.
LLM_PROVIDER=deepseek
LLM_FALLBACK_PROVIDER=gemini
DEEPSEEK_API_KEY=your_deepseek_or_siliconflow_api_key
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Flash
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=models/gemini-2.5-flash

# Map
MAP_PROVIDER=amap
MAP_API_KEY=your_amap_api_key
AMAP_SECRET=your_amap_secret

# Weather
WEATHER_PROVIDER=qweather
QWEATHER_API_KEY=your_qweather_api_key
QWEATHER_API_HOST=https://your-project-id.re.qweatherapi.com

# Google Calendar sync
GOOGLE_CALENDAR_ENABLED=true
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8888/auth/callback
GOOGLE_CALENDAR_ID=primary
GOOGLE_CLIENT_SECRET_JSON_PATH=./plan_doc/client_secret_xxx.json

# Notification channels
NOTIFICATION_IN_APP=true
NOTIFICATION_DESKTOP=true

# Feature flags
ASSISTANT_CONDUCTOR_MODE=proposal
ASSISTANT_PROACTIVE_MODE=off
VOICE_INPUT_ENABLED=false
VOICE_OUTPUT_ENABLED=false
VOICE_INPUT_MODEL=base
VOICE_OUTPUT_LANG=zh-CN
